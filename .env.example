# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/coding_event_db?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/coding_event_db?schema=public

# Authentication & Security
JWT_SECRET=your_jwt_secret_placeholder_do_not_use_in_production

# Frontend Client URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# Default Development Credentials
DEFAULT_ADMIN_USERNAME=admin@it.com
DEFAULT_ADMIN_PASSWORD=admin@it
DEFAULT_STUDENT_PASSWORD=welcome@sara
CONTINUATION_PASSWORD=

# Judge0 Execution Engine (Optional for later steps)
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
