# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Authentication & Security
JWT_SECRET=your_jwt_secret_placeholder_do_not_use_in_production
INVIGILATOR_PASSWORD=admin@sara

# Frontend Client URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# Default Credentials
DEFAULT_ADMIN_USERNAME=admin@it.com
DEFAULT_ADMIN_PASSWORD=admin@it
DEFAULT_STUDENT_PASSWORD=welcome@sara

# Optional Code Execution Service Configuration
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
